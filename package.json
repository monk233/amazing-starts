{
  "name": "amazing-starts",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Chrome extension for your GitHub Stars.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:design": "node scripts/preview-design.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
